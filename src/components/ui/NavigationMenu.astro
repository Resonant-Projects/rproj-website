---
import { Icon } from 'astro-icon/components';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface MenuLink extends Link {
  links?: Array<MenuLink>;
}

export interface Props {
  links: Array<MenuLink>;
  className?: string;
  orientation?: 'horizontal' | 'vertical';
  showChevrons?: boolean;
}

const { links = [], className = '', orientation = 'horizontal', showChevrons = true } = Astro.props as Props;

const currentPath = new URL(Astro.url).pathname;
const currentFor = (href?: string) => (href === currentPath ? 'page' : undefined);
---

<!-- Rendered inside the header's <nav id="navigation"> landmark. Dropdowns follow the
     disclosure pattern: aria-expanded is their only state, and Escape is handled
     globally by Layout.astro. -->
<ul class:list={['nav-list', `nav-list--${orientation}`, className]}>
  {links.map((link, index) =>
    link.links?.length ? (
      <li class="nav-item nav-item--dropdown">
        <button
          type="button"
          class="nav-link nav-link--dropdown"
          aria-expanded="false"
          aria-controls={`nav-dropdown-menu-${index}`}
          data-current={link.links.some(subLink => subLink.href === currentPath) || undefined}
        >
          {link.text}
          {showChevrons && <Icon name="tabler:chevron-down" class="nav-chevron" aria-hidden="true" />}
        </button>
        <ul class="dropdown-menu" id={`nav-dropdown-menu-${index}`}>
          {link.links.map(subLink => (
            <li>
              <a
                href={subLink.href}
                class="dropdown-link"
                aria-current={currentFor(subLink.href)}
                aria-label={subLink.ariaLabel}
              >
                {subLink.icon && <Icon name={subLink.icon} class="nav-icon" aria-hidden="true" />}
                {subLink.text}
              </a>
            </li>
          ))}
        </ul>
      </li>
    ) : (
      <li class="nav-item">
        <a href={link.href} class="nav-link" aria-current={currentFor(link.href)} aria-label={link.ariaLabel}>
          {link.icon && <Icon name={link.icon} class="nav-icon" aria-hidden="true" />}
          {link.text}
        </a>
      </li>
    )
  )}
</ul>

<style>
  .nav-list {
    --nav-tint: color-mix(in oklch, var(--color-accent) 12%, transparent);
    --nav-tint-strong: color-mix(in oklch, var(--color-accent) 20%, transparent);

    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-family-primary);
  }

  .nav-item {
    position: relative;
  }

  .nav-link,
  .dropdown-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-block-size: 2.75rem;
    padding: 0.5rem 1rem;
    border: none;
    border-radius: var(--radius);
    background-color: transparent;
    color: var(--color-foreground);
    font: inherit;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color 150ms var(--ease-out, ease-out),
      color 150ms var(--ease-out, ease-out);
  }

  .nav-link {
    font-size: 0.9375rem;
    white-space: nowrap;
  }

  .dropdown-link {
    font-size: 0.875rem;
  }

  .nav-link:focus-visible,
  .dropdown-link:focus-visible {
    outline: 2px solid var(--color-outline);
    outline-offset: 2px;
  }

  @media (hover: hover) and (pointer: fine) {
    .nav-link:hover,
    .dropdown-link:hover {
      background-color: var(--nav-tint);
    }
  }

  .nav-link:active,
  .dropdown-link:active {
    background-color: var(--nav-tint-strong);
  }

  /* Current page: a quiet tint, leaving solid violet to the primary CTA */
  .nav-list [aria-current='page'] {
    background-color: var(--nav-tint);
    color: var(--color-primary);
    font-weight: 600;
  }

  /* The section containing the current page */
  .nav-link--dropdown[data-current] {
    color: var(--color-primary);
  }

  .nav-icon {
    inline-size: 1.25rem;
    block-size: 1.25rem;
    flex-shrink: 0;
  }

  .nav-chevron {
    inline-size: 1rem;
    block-size: 1rem;
    flex-shrink: 0;
    opacity: 0.7;
  }

  [aria-expanded='true'] > .nav-chevron {
    rotate: 180deg;
  }

  .dropdown-menu {
    margin: 0;
    list-style: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .nav-chevron {
      transition: rotate 200ms var(--ease-out, ease-out);
    }
  }

  /* Mobile panel: dropdowns are accordions in the flow */
  @media (width < 48rem) {
    .nav-link {
      font-size: 1.0625rem;
    }

    .nav-link--dropdown {
      inline-size: 100%;
    }

    .nav-link--dropdown .nav-chevron {
      margin-inline-start: auto;
    }

    .dropdown-link {
      font-size: 1rem;
      color: var(--color-muted-foreground);
    }

    .dropdown-menu {
      interpolate-size: allow-keywords;
      block-size: 0;
      overflow: clip;
      visibility: hidden;
      padding: 0 0 0 1rem;
    }

    .nav-link--dropdown[aria-expanded='true'] + .dropdown-menu {
      block-size: auto;
      visibility: visible;
    }

    @media (prefers-reduced-motion: no-preference) {
      .dropdown-menu {
        transition:
          block-size 250ms var(--ease-out, ease-out),
          visibility 250ms;
      }
    }
  }

  /* Desktop: dropdowns float below their trigger */
  @media (width >= 48rem) {
    .nav-list--horizontal {
      flex-direction: row;
      align-items: center;
      gap: 0.5rem;
    }

    .nav-link--dropdown[aria-expanded='true'] {
      background-color: var(--nav-tint);
    }

    .dropdown-menu {
      position: absolute;
      inset-block-start: 100%;
      inset-inline-start: 0;
      z-index: 50;
      min-inline-size: 12rem;
      margin-block-start: 0.5rem;
      padding: 0.5rem;
      background-color: var(--color-card);
      /* Transparent so only forced-colors mode draws it; elevation comes from the shadow */
      border: 1px solid transparent;
      border-radius: var(--radius);
      box-shadow:
        0 10px 38px -10px oklch(0.2 0.03 330 / 0.35),
        0 10px 20px -15px oklch(0.2 0.03 330 / 0.2);
      opacity: 0;
      visibility: hidden;
      transition:
        opacity 150ms var(--ease-out, ease-out),
        visibility 150ms;
    }

    :global(.dark) .dropdown-menu {
      box-shadow:
        0 10px 38px -10px oklch(0 0 none / 0.5),
        0 10px 20px -15px oklch(0 0 none / 0.3);
    }

    /* Bridges the gap to the trigger so hover survives the pointer's trip down */
    .dropdown-menu::before {
      content: '';
      position: absolute;
      inset-inline: 0;
      inset-block-end: 100%;
      block-size: 0.5rem;
    }

    .nav-link--dropdown[aria-expanded='true'] + .dropdown-menu {
      opacity: 1;
      visibility: visible;
      translate: none;
    }

    @media (hover: hover) and (pointer: fine) {
      .nav-item--dropdown:hover .dropdown-menu {
        opacity: 1;
        visibility: visible;
        translate: none;
      }
    }

    @media (prefers-reduced-motion: no-preference) {
      .dropdown-menu {
        translate: 0 -0.25rem;
        transition:
          opacity 150ms var(--ease-out, ease-out),
          translate 150ms var(--ease-out, ease-out),
          visibility 150ms;
      }
    }
  }
</style>

<script>
  const closeDropdowns = (except?: Element) => {
    document.querySelectorAll('.nav-link--dropdown[aria-expanded="true"]').forEach(button => {
      if (button !== except) button.setAttribute('aria-expanded', 'false');
    });
  };

  const initNavigationMenus = () => {
    document.querySelectorAll<HTMLButtonElement>('.nav-link--dropdown:not([data-initialized])').forEach(button => {
      button.dataset.initialized = 'true';
      button.addEventListener('click', () => {
        closeDropdowns(button);
        button.setAttribute('aria-expanded', String(button.getAttribute('aria-expanded') !== 'true'));
      });
    });
  };

  // Module scripts run once per session, so these listeners are bound once;
  // astro:page-load re-initializes buttons swapped in by View Transitions.
  document.addEventListener('click', event => {
    if (!(event.target as Element).closest('.nav-item--dropdown')) closeDropdowns();
  });
  // An accordion left open on mobile must not reappear as a popover on desktop.
  window.matchMedia('(width >= 48rem)').addEventListener('change', () => closeDropdowns());
  document.addEventListener('astro:page-load', initNavigationMenus);
  initNavigationMenus();
</script>
