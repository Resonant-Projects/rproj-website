---
export interface Props {
  label?: string;
  controls?: string;
  class?: string;
}

const {
  label = 'Menu',
  controls = 'navigation',
  class:
    className = 'group flex h-12 w-12 cursor-pointer flex-col items-center justify-center rounded-sm text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary active:scale-95 motion-safe:transition-[scale]',
} = Astro.props;

const bar =
  'my-1 h-0.5 w-6 rounded-full bg-current opacity-80 motion-safe:transition-[translate,rotate,opacity] motion-safe:duration-200 motion-safe:ease-out';
---

<!-- aria-expanded is the mobile menu's only state; BasicScripts flips it and the header styles follow. -->
<button
  type="button"
  class={className}
  aria-label={label}
  aria-expanded="false"
  aria-controls={controls}
  data-aw-toggle-menu
>
  <slot>
    <span
      aria-hidden="true"
      class:list={[bar, 'group-aria-expanded:translate-y-2.5 group-aria-expanded:rotate-45']}
    ></span>
    <span aria-hidden="true" class:list={[bar, 'group-aria-expanded:opacity-0']}></span>
    <span
      aria-hidden="true"
      class:list={[bar, 'group-aria-expanded:-translate-y-2.5 group-aria-expanded:-rotate-45']}
    ></span>
  </slot>
</button>
