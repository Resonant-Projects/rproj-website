---
import Layout from '~/layouts/PageLayout.astro';
import BlogList from '~/components/blog/List.astro';
import Headline from '~/components/blog/Headline.astro';
import Header from '~/components/widgets/Header.astro';
import { headerData } from '~/navigation';
import Pagination from '~/components/blog/Pagination.astro';
import PostTags from '~/components/blog/Tags.astro';
import Search from '~/components/ui/Search.astro';

import {
  blogListRobots,
  blogPostsPerPage,
  fetchPosts,
  findCategories,
  findTags,
  isBlogEnabled,
  isBlogListRouteEnabled,
} from '~/utils/blog';
import { paginateItems, parsePageParam } from '~/utils/blog-pagination';
import { getBlogPermalink } from '~/utils/permalinks';

export const prerender = false;

if (!isBlogEnabled || !isBlogListRouteEnabled) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const pageNumber = parsePageParam(Astro.params.page);
if (pageNumber === null) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const posts = await fetchPosts();
const page = paginateItems(posts, pageNumber, blogPostsPerPage || 6, getBlogPermalink());
if (!page) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const currentPage = page.currentPage;
const allCategories = await findCategories();
const allTags = await findTags();

const metadata = {
  title: `Blog${currentPage > 1 ? ` — Page ${currentPage}` : ''}`,
  robots: {
    index: blogListRobots?.index && currentPage === 1,
    follow: blogListRobots?.follow,
  },
  openGraph: {
    type: 'blog',
  },
};
---

<Layout metadata={metadata}>
  <Fragment slot="header">
    <Header {...headerData} isSticky showRssFeed={false} showToggleTheme />
  </Fragment>
  <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <section class="mx-auto max-w-4xl px-6 py-12 sm:px-6 sm:py-16 lg:py-20">
    <Headline subtitle="Exploring innovative solutions, sharing insights, and documenting the journey of creative technology projects">
      Resonant Projects Blog
    </Headline>
    <Search
      id="search"
      className="pagefind-ui pb-8"
      uiOptions={{
        showSubResults: true,
        resetStyles: false,
        showEmptyFilters: false,
      }}
    />
    <BlogList posts={page.data} />
    <Pagination prevUrl={page.url.prev} nextUrl={page.url.next} />

    <PostTags tags={allCategories} class="mb-2" title="Search by Categories:" isCategory />
    <PostTags tags={allTags} title="Search by Tags:" />
  </section>
</Layout>
